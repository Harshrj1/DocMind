# ==============================================================================
# DocMind Backend Environment Configuration (.env.example)
# Copy this file to .env and configure with your actual credentials.
# Do NOT commit actual secrets or API keys to version control.
# ==============================================================================

# Application Profile & Port
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5434
DB_NAME=docmind
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# Alternative Full Connection URL (takes precedence if defined; useful on Render/Neon/Supabase)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/docmind

# Google Gemini AI Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# JWT Secret Key (Must be at least 256 bits / 32 characters long)
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_256_bits_long_here

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
